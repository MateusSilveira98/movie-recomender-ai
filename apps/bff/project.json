{
  "name": "bff",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bff/src",
  "tags": ["scope:bff", "type:app"],
  "targets": {
    "serve": {
      "command": "tsx watch --tsconfig tsconfig.base.json apps/bff/src/main.ts"
    },
    "build": {
      "command": "tsc -p apps/bff/tsconfig.json"
    },
    "typecheck": {
      "command": "tsc -p apps/bff/tsconfig.json --noEmit"
    },
    "test": {
      "command": "tsx --tsconfig tsconfig.base.json --test apps/bff/src/app/app.spec.ts apps/bff/src/domains/movies/repositories/movies.repository.spec.ts apps/bff/src/domains/sessions/repositories/sessions.repository.spec.ts apps/bff/src/domains/sessions/services/session-feedback.service.spec.ts"
    }
  }
}
