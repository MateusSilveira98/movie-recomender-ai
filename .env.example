# libSQL server
SQLD_DB_PATH=/var/lib/sqld/movie-recomender-ai.db
SQLD_HTTP_LISTEN_ADDR=0.0.0.0:8080
SQLD_GRPC_LISTEN_ADDR=0.0.0.0:8081
SQLD_HTTP_HOST_PORT=127.0.0.1:18080
SQLD_GRPC_HOST_PORT=127.0.0.1:18081
DATABASE_DATA_DIR=/var/lib/sqld
WORKSPACE_DIR=/workspace

# BFF and import queue
BFF_PORT=3333
BFF_HOST_PORT=127.0.0.1:3333
DATABASE_URL=http://database:8080
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=docker-local
UPLOAD_STORAGE_DIR=/var/lib/movie-recommender/uploads
UPLOAD_MAX_BYTES=1073741824
DATASET_IMPORT_ADMIN_TOKEN=

# RabbitMQ local para distribuição futura dos chunks de ratings.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_URL=amqp://RABBITMQ_DEFAULT_USER:RABBITMQ_DEFAULT_PASS@rabbitmq:5672
RABBITMQ_AMQP_HOST_PORT=127.0.0.1:15672
RABBITMQ_MANAGEMENT_HOST_PORT=127.0.0.1:15673

# Armazenamento local S3/R2 compatível para artefatos de ML.
# Preencha as credenciais somente no .env local; não versione valores reais.
# Para ambiente local, use credenciais distintas para root, publicação e leitura.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_HOST_PORT=127.0.0.1:19000
MINIO_CONSOLE_HOST_PORT=127.0.0.1:19001

MODEL_STORAGE_ENDPOINT=http://minio:9000
MODEL_STORAGE_REGION=us-east-1
MODEL_STORAGE_FORCE_PATH_STYLE=true
MODEL_STORAGE_BUCKET=movie-models
MODEL_STORAGE_PREFIX=movie-recommender
# Deixe vazio para iniciar o BFF somente com a heurística.
# Defina uma versão imutável antes de executar o perfil `maintenance` do treino.
MODEL_VERSION=

MODEL_PUBLISHER_ACCESS_KEY=
MODEL_PUBLISHER_SECRET_KEY=
MODEL_READER_ACCESS_KEY=
MODEL_READER_SECRET_KEY=

# Objetos CSV temporários de importação; use bucket separado dos artefatos de modelo.
DATASET_IMPORT_STORAGE_BUCKET=dataset-imports
DATASET_IMPORT_STORAGE_ENDPOINT=http://minio:9000
DATASET_IMPORT_STORAGE_REGION=us-east-1
DATASET_IMPORT_STORAGE_FORCE_PATH_STYLE=true

# Observabilidade. Axiom é só produção. O Compose local não exporta
# enquanto APP_ENV=docker-local e OTEL_ENABLED não for true.
OTEL_ENABLED=
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
AXIOM_TOKEN=
AXIOM_EVENTS_DATASET=movie-recommender-events
AXIOM_METRICS_DATASET=movie-recommender-metrics
