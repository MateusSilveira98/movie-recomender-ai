# libSQL server
SQLD_DB_PATH=/var/lib/sqld/movie-recomender-ai.db
SQLD_HTTP_LISTEN_ADDR=0.0.0.0:8080
SQLD_GRPC_LISTEN_ADDR=0.0.0.0:8081
SQLD_HTTP_HOST_PORT=127.0.0.1:18080
SQLD_GRPC_HOST_PORT=127.0.0.1:18081
DATABASE_DATA_DIR=/var/lib/sqld
WORKSPACE_DIR=/workspace

# BFF and import queue
BFF_PORT=3333
BFF_HOST_PORT=127.0.0.1:3333
DATABASE_URL=http://database:8080
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=docker-local
UPLOAD_STORAGE_DIR=/var/lib/movie-recommender/uploads
UPLOAD_MAX_BYTES=1073741824
